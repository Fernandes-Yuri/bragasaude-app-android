# Exemplo de configuração de Keystore de Release para o Braga Saúde
# Copie este arquivo como 'keystore.properties' (que já está protegido no .gitignore)
# e preencha com o caminho e senhas da sua chave de release.

storeFile=release-keystore.jks
storePassword=SuaSenhaDoKeystoreAqui
keyAlias=bragasaude_key
keyPassword=SuaSenhaDaChaveAqui
